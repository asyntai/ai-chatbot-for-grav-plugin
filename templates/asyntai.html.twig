{% extends 'partials/base.html.twig' %}

{% set a = asyntai_chatbot_admin() %}

{% block titlebar %}
<div class="button-bar">
    <a class="button" href="{{ base_url }}"><i class="fa fa-reply"></i> {{ "PLUGIN_ADMIN.BACK"|tu }}</a>
</div>
<h1><i class="fa fa-fw fa-comments"></i> Asyntai AI Chatbot</h1>
{% endblock %}

{% block content %}
<style>
.asyntai-wrap{max-width:820px;margin:0 auto;padding:20px 20px 40px}
.asyntai-panel{background:#fff;border:1px solid #e0e0e0;padding:20px 22px;margin:0 0 16px;color:#111}
.asyntai-panel h3{margin:0 0 10px;font-size:20px;font-weight:700;letter-spacing:-.02em;color:#111}
.asyntai-panel p{color:#555;font-size:14px;max-width:94ch}
.asyntai-btn{display:inline-block;background:#111;color:#fff;border:1px solid #111;padding:10px 20px;font-size:14px;font-weight:600;cursor:pointer;text-decoration:none;line-height:1.4;border-radius:0}
.asyntai-btn:hover,.asyntai-btn:focus{background:#000;color:#fff;text-decoration:none}
.asyntai-state{margin:0 0 6px;font-size:15px;font-weight:600;color:#111}
.asyntai-dot{display:inline-block;width:8px;height:8px;margin-right:9px;vertical-align:middle;background:#1a7f37}
.asyntai-check{display:flex;gap:10px;align-items:flex-start;margin:14px 0;color:#111;font-size:14px;cursor:pointer}
.asyntai-check input{margin-top:3px}
.asyntai-fine{color:#757575;font-size:12px}
.asyntai-links{margin:10px 0 0;display:flex;gap:20px;flex-wrap:wrap}
.asyntai-links a{color:#555}.asyntai-danger{color:#b32d2e !important}
.asyntai-alert{border:1px solid #e0e0e0;border-left-width:3px;padding:10px 14px;margin:0 0 16px;background:#fff;color:#111}
</style>

<div class="asyntai-wrap">
  <div id="asyntai-alert" class="asyntai-alert" style="display:none;"></div>

  {% if not a.connected %}
    <div class="asyntai-panel">
      <h3>Connect your site to Asyntai</h3>
      <p>Create a free Asyntai account or sign in. The chatbot then appears on every page of this site.</p>
      <label class="asyntai-check">
        <input type="checkbox" id="asyntai-share" checked>
        <span>Share my published pages with the chatbot, so its answers stay up to date.<br>
        <span class="asyntai-fine">Only published pages that any visitor can open. You can switch this off at any time.</span></span>
      </label>
      <p><button type="button" id="asyntai-connect" class="asyntai-btn">Get started</button></p>
    </div>
  {% else %}
    <div class="asyntai-panel">
      <p class="asyntai-state"><span class="asyntai-dot"></span>The chatbot is live on your site</p>
      {% if a.account_email %}<p>Connected as {{ a.account_email }}</p>{% endif %}
      <label class="asyntai-check">
        <input type="checkbox" id="asyntai-share-toggle" {{ a.sharing ? 'checked' : '' }}>
        <span>Share my published pages with the chatbot<br>
        <span class="asyntai-fine" id="asyntai-sync">{{ a.sharing ? 'Checking what Asyntai has read...' : 'Switched off.' }}</span></span>
      </label>
      <p class="asyntai-links">
        <a href="https://asyntai.com/dashboard" target="_blank" rel="noopener">Open the Asyntai dashboard</a>
        <a href="https://asyntai.com/dashboard#setup" target="_blank" rel="noopener">Change how the AI answers</a>
        <a href="#" id="asyntai-disconnect" class="asyntai-danger">Disconnect</a>
      </p>
    </div>
  {% endif %}
</div>

<script>
(function () {
  var cfg = {
    endpoint: {{ a.endpoint|json_encode|raw }},
    nonce: {{ a.nonce|json_encode|raw }},
    sharing: {{ a.sharing ? 'true' : 'false' }},
    hasToken: {{ a.has_token ? 'true' : 'false' }}
  };
  var popup = null;

  function say(message, ok) {
    var box = document.getElementById('asyntai-alert');
    if (!box) { return; }
    box.style.display = 'block';
    box.style.borderLeftColor = ok ? '#1a7f37' : '#b32d2e';
    box.textContent = message;
  }

  // Every call goes to this site's own admin endpoint. Nothing is loaded
  // from Asyntai as a script inside the administration.
  function call(task, extra) {
    var body = extra || {};
    body.task = task;
    body.admin_nonce = cfg.nonce;
    return fetch(cfg.endpoint, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify(body)
    }).then(function (response) {
      return response.text().then(function (raw) {
        var parsed;
        try { parsed = JSON.parse(raw); } catch (e) {
          var lost = new Error('Your Grav session has ended. Please reload the page and sign in again.');
          lost.signedOut = true;
          throw lost;
        }
        if (!parsed || parsed.success !== true) {
          throw new Error((parsed && parsed.message) || 'Something went wrong. Please try again.');
        }
        return parsed.data || {};
      });
    });
  }

  // The window opens inside the click, before any network call, or the
  // browser treats it as unrequested and blocks it.
  function connect(forceShare) {
    popup = window.open('about:blank', 'asyntai_connect', 'width=820,height=740,scrollbars=yes,resizable=yes');
    if (!popup) { say('Your browser blocked the sign-in window. Please allow pop-ups for this site and try again.', false); return; }
    say('Preparing the connection...', true);
    var share = document.getElementById('asyntai-share');
    call('prepare', { share: forceShare || (share ? share.checked : false) }).then(function (data) {
      popup.location = data.url;
      say('Waiting for you to sign in to Asyntai in the new window...', true);
      poll(data.state, 0);
    }).catch(function (error) {
      if (popup) { try { popup.close(); } catch (e) {} }
      say(error.message, false);
    });
  }

  function poll(state, attempt) {
    if (attempt > 300) { say('The sign-in took too long. Please press Get started again.', false); return; }
    call('poll', { state: state }).then(function (data) {
      if (data && data.ready) {
        say('Connected. Saving...', true);
        return call('finish', {}).then(function () { window.location.reload(); });
      }
      setTimeout(function () { poll(state, attempt + 1); }, 2000);
    }).catch(function (error) {
      if (error && error.signedOut) {
        if (popup) { try { popup.close(); } catch (e) {} }
        say(error.message, false);
        return;
      }
      setTimeout(function () { poll(state, attempt + 1); }, 3000);
    });
  }

  function showSync(tries) {
    tries = tries || 0;
    var line = document.getElementById('asyntai-sync');
    if (!line || !cfg.sharing) { return; }
    call('sync', {}).then(function (data) {
      var s = data && data.sync;
      if (!s) { line.textContent = 'Asyntai has not read your pages yet.'; return; }
      if (s.status === 'syncing') {
        line.textContent = 'Asyntai is reading your pages now...';
        if (tries < 20) { setTimeout(function () { showSync(tries + 1); }, 5000); }
        return;
      }
      if (s.status === 'failed') { line.textContent = 'The last read failed: ' + (s.error || 'unknown error'); return; }
      line.textContent = 'Pages shared: ' + (s.count || 0) + ' items. Asyntai checks them again for changes.';
    }).catch(function () { line.textContent = ''; });
  }

  document.addEventListener('click', function (event) {
    var target = event.target;
    if (!target) { return; }
    if (target.id === 'asyntai-connect') {
      event.preventDefault();
      connect(false);
    } else if (target.id === 'asyntai-disconnect') {
      event.preventDefault();
      if (!window.confirm('Disconnect this site from Asyntai? The chatbot disappears from your pages.')) { return; }
      call('disconnect', {}).then(function () { window.location.reload(); })
        .catch(function (error) { say(error.message, false); });
    }
  });

  document.addEventListener('change', function (event) {
    var target = event.target;
    if (!target || target.id !== 'asyntai-share-toggle') { return; }
    var wanted = target.checked;
    if (wanted && !cfg.hasToken) {
      // Connected before page sharing existed: Asyntai has no key for this
      // site yet, so the owner signs in once more to hand one over.
      target.checked = false;
      connect(true);
      return;
    }
    call('share', { enabled: wanted }).then(function (data) {
      if (data && data.needs_connect) {
        target.checked = false;
        say('To share your pages, please sign in to Asyntai once more.', false);
        return;
      }
      cfg.sharing = wanted;
      say(wanted ? 'Page sharing is on.' : 'Page sharing is off. Asyntai removes the shared pages at its next read.', true);
      var line = document.getElementById('asyntai-sync');
      if (line) { line.textContent = wanted ? 'Asyntai reads your pages once a day.' : 'Switched off.'; }
      showSync();
    }).catch(function (error) {
      target.checked = !wanted;
      say(error.message, false);
    });
  });

  showSync();
})();
</script>
{% endblock %}
